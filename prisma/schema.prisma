generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id           String   @id @default(cuid())
  name         String   @unique
  is_preferred Boolean  @default(false)
  is_excluded  Boolean  @default(false)

  problems  ProblemCompany[]
  resources ResourceCompany[]
}

// A collective title over sibling stages (Stage 4A + 4B = "Two Pointers"). Display order
// follows the stages' own order, so a group has no order of its own.
model StageGroup {
  id    String @id @default(cuid())
  title String @unique

  stages Stage[]
}

model Stage {
  id            String  @id @default(cuid())
  stage_label   String
  title         String
  insight_note  String
  order         Int
  is_bridge     Boolean @default(false)
  group_id      String?

  group    StageGroup? @relation(fields: [group_id], references: [id], onDelete: SetNull)
  problems ProblemStage[]
  reviews  ReviewLog[]
}

enum Tier {
  Core
  Supp
  Stretch
}

enum Difficulty {
  Easy
  Medium
  Hard
}

model Problem {
  id              String      @id @default(cuid())
  title           String
  leetcode_id     Int?        @unique
  difficulty      Difficulty?
  source_link     String?     @unique
  neetcode_link   String?     @unique
  acceptance_rate Float?
  frequency       Float?
  is_solved       Boolean     @default(false)
  is_premium      Boolean     @default(false)
  note            String?

  // Written by the user, never by the import scripts. `note` above is imported text.
  confidence       Int? // 1-5, null = unrated. Range enforced in the server actions.
  last_solved_date DateTime?
  user_note        String?

  // Last time any review-worthy event happened (Solved or Revised — not a bare Revisited glance).
  // The review queue's staleness clock reads this, not last_solved_date: a Revise (re-reading the
  // solution/notes without a fresh solve) is meaningful engagement and should reset it too.
  last_reviewed_date DateTime?

  stages    ProblemStage[]
  companies ProblemCompany[]
  reviews   ReviewLog[]
  tags      ProblemTag[]

  quiz_approaches QuizApproach[]
}

// User-defined labels ("Revisit", "Tricky", ...) on a problem's identity, not on a stage placement.
// A few are pre-added (is_preset, seeded by the migration); they can be deleted like any other. Names are unique
// case-insensitively; the server actions enforce that. `color` is a key into lib/tags.ts.
model Tag {
  id         String   @id @default(cuid())
  name       String   @unique
  color      String
  is_preset  Boolean  @default(false)
  created_at DateTime @default(now())

  problems ProblemTag[]
}

model ProblemTag {
  problem_id String
  tag_id     String
  created_at DateTime @default(now())

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([problem_id, tag_id])
  @@index([tag_id])
}

enum ReviewEventType {
  Solved
  Revised // reviewed/studied again (e.g. re-read the solution or notes) without a fresh solve
  Revisited // just looked at it again, no real engagement
}

// One row per review event (a solve, a revise, or a bare revisit) — not just solves any more.
// Unticking never deletes rows. stage_id is recorded only when the problem sits in more than one
// stage (and only ever for a Solved row, since Revise/Revisit don't drive any placement's checkbox);
// solved_at null on a Solved row means "solved, date unknown".
model ReviewLog {
  id                 String          @id @default(cuid())
  problem_id         String
  stage_id           String?
  event_type         ReviewEventType @default(Solved)
  solved_at          DateTime?
  confidence_at_time Int?
  created_at         DateTime        @default(now())

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  stage   Stage?  @relation(fields: [stage_id], references: [id], onDelete: SetNull)

  @@index([problem_id])
}

model ProblemStage {
  problem_id    String
  stage_id      String
  roadmap_order Int
  tier          Tier?
  is_priority   Boolean @default(false)
  is_solved     Boolean @default(false)

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  stage   Stage   @relation(fields: [stage_id], references: [id], onDelete: Cascade)

  @@id([problem_id, stage_id])
}

enum ResourceType {
  OAReport
  InterviewExperience
  Article
  CoreSubject
  Aptitude
  Other
}

enum Credibility {
  High
  Medium
  Low
}

model Resource {
  id           String       @id @default(cuid())
  title        String
  topic        String?
  type         ResourceType
  link         String?
  note         String?
  credibility  Credibility
  date_added   DateTime     @default(now())

  companies ResourceCompany[]
}

// `frequency` is the source's ask-rate for this company on this problem — the true grain of the
// number. `Problem.frequency` used to hold it, but a problem has one row there and many companies,
// so it ended up holding whichever company the import happened to read first (Adobe's 75% on Two
// Sum). Nothing reads `Problem.frequency`; it is left null by the import now.
model ProblemCompany {
  problem_id String
  company_id String
  frequency  Float?

  problem Problem @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@id([problem_id, company_id])
  @@index([company_id])
}

model ResourceCompany {
  resource_id String
  company_id  String

  resource Resource @relation(fields: [resource_id], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@id([resource_id, company_id])
}

enum ItemLinkType {
  SameProblem // symmetric: the same underlying problem, phrased/sourced differently
  HarderVariant // directional: to_id is the harder version of from_id
  SameInsight // symmetric: different problems, same core idea
  Prerequisite // directional: from_id should be solved before to_id
  FreeForm // no implied relationship; the label carries the meaning
}

enum LinkCreator {
  User
  System // reserved for Phase 5 (embeddings/LLM); nothing writes this yet
}

// A user-made connection between two items (spec 010, Phase 3 of CLAUDE.local.md's link layer).
// Deliberately polymorphic with no FK integrity — from_type/to_type/from_id/to_id are plain
// strings, not relations, so this can point at a Resource or a future Concept later without a
// migration; the app is responsible for cleaning up rows when the thing they point at is deleted.
// v1 only ever writes from_type = to_type = "Problem". Symmetric types (SameProblem, SameInsight)
// are stored once and shown identically from either end; directional types (HarderVariant,
// Prerequisite) read differently depending which side you're looking from.
model ItemLink {
  id         String       @id @default(cuid())
  from_type  String
  from_id    String
  to_type    String
  to_id      String
  link_type  ItemLinkType
  label      String?
  created_by LinkCreator  @default(User)
  created_at DateTime     @default(now())

  @@index([from_type, from_id])
  @@index([to_type, to_id])
}

enum QuizApproachOrigin {
  Standard // from a trusted solution source (NeetCode); nothing writes this yet
  User // the user's own code
}

enum QuizQuestionOrigin {
  Seeded // hand-written by the user and stored as given
  Generated // reserved: written by an LLM from an approach (later slice)
  UserEdited // reserved: a generated question the user corrected
}

// The pattern tag from docs/quiz-question-patterns.md. Questions are reviewed and dropped by
// pattern, so every question carries exactly one.
enum QuizCategory {
  Intuition
  CodeReading
  Tracing
  EdgeCase
  Complexity
  Counterfactual
  FinalUnderstanding
}

// One way of solving a problem that a quiz is built around (spec 011). A problem can have several;
// the first screen of a quiz asks which one the user used. `code` is the reference code the
// questions were written against.
model QuizApproach {
  id            String             @id @default(cuid())
  problem_id    String
  name          String
  origin        QuizApproachOrigin @default(Standard)
  code          String?
  solution_link String?
  position      Int                @default(0)
  created_at    DateTime           @default(now())

  problem   Problem        @relation(fields: [problem_id], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@unique([problem_id, name])
}

// A 4-option multiple-choice question. `options` is a JSON array of strings in canonical order and
// `correct_index` points into it; the quiz shuffles the display order every time, so neither the
// stored order nor the key position is ever shown. `source_key` is a stable id from the seed data
// so a re-run updates the same row instead of duplicating it. `verified` is true only when the
// answer was checked by running the reference code (spec 011 D2), never for conceptual questions.
model QuizQuestion {
  id            String             @id @default(cuid())
  approach_id   String
  source_key    String
  set_label     String?
  category      QuizCategory
  position      Int
  text          String
  snippet       String?
  options       Json
  correct_index Int
  explanation   String?
  // Which lines of the approach's code the explanation is about: a JSON array of matching-text specs
  // (see lib/quizHighlight.ts), not line numbers, so it survives edits to the code. Null = none.
  highlight     Json?
  verified      Boolean            @default(false)
  origin        QuizQuestionOrigin @default(Seeded)
  created_at    DateTime           @default(now())

  approach QuizApproach        @relation(fields: [approach_id], references: [id], onDelete: Cascade)
  feedback QuizQuestionFeedback[]

  @@unique([approach_id, source_key])
  @@index([approach_id, position])
}

// One finished run of a quiz. Written once at the end; `answers` holds one object per question
// asked ({ question_id, chosen_index, correct }) with chosen_index in the question's canonical
// option order. Quiz results are deliberately separate from Problem.confidence (spec 011 D4).
model QuizAttempt {
  id             String   @id @default(cuid())
  approach_id    String
  finished_at    DateTime @default(now())
  question_count Int
  correct_count  Int
  answers        Json

  approach QuizApproach @relation(fields: [approach_id], references: [id], onDelete: Cascade)

  @@index([approach_id, finished_at])
}

// Why a question was flagged. These are the user's own curation rules (docs/quiz-question-patterns.md)
// turned into one-click reasons, so what they flag is what a later question generator should avoid.
enum QuizFeedbackReason {
  TooEasy
  Repetitive
  WrongAnswer
  UnclearWording
  ExplanationOff
  HighlightOff
  Other
}

// A flag with an optional note on one question. A question counts as flagged while it has a row with
// resolved_at null; the UI keeps at most one such row per question (saving again edits it, removing
// the flag deletes it). resolved_at is for when the feedback has been acted on (a question reworded,
// pruned from the seed, and so on), which keeps the history without leaving the flag on.
model QuizQuestionFeedback {
  id          String             @id @default(cuid())
  question_id String
  reason      QuizFeedbackReason
  comment     String?
  created_at  DateTime           @default(now())
  resolved_at DateTime?

  question QuizQuestion @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@index([question_id])
}
